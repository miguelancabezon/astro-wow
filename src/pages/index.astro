---
import BaseLayout from "../layouts/BaseLayout.astro";

const getUser = () => {
  return Math.random() > 0.5
    ? { name: "John Doe", email: "john.doe@wowbooks.com" }
    : { name: "Jane Smith", email: "jane.smith@wowbooks.com" };
};

const user = getUser();
---

<BaseLayout>
  <div class="content">
	{user && (
		<h2>Welcome, {user.name}!</h2>
    <p>
      Logged in as: {user.email}
    </p>
	)}
    <p>
      Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod
      tempor incididunt ut labore et dolore magna aliqua.
    </p>
    <a href="/books">View Books</a>
  </div>
</BaseLayout>

<style>
  .content {
    text-align: center;
  }

  a {
    display: inline-block;
    background-color: #7a49c5;
    color: #fff;
    padding: 6px 10px;
    border-radius: 2px;
    text-decoration: none;
    margin-top: 20px;
  }

  a:hover {
    background-color: #965ee9;
  }
</style>
