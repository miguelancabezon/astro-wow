---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BookCard from "../../components/BookCard.astro";

interface Book {
  title: string;
  author: string;
}

const books: Book[] = [
  { title: "The Final Empire", author: "Brandon Sanderson" },
  { title: "The Way of Kings", author: "Brandon Sanderson" },
  { title: "The Name of the Wind", author: "Patrick Rothfuss" },
  { title: "The Wise Man's Fear", author: "Patrick Rothfuss" },
  { title: "The Hobbit", author: "J.R.R. Tolkien" },
  { title: "The Fellowship of the Ring", author: "J.R.R. Tolkien" },
  { title: "The Two Towers", author: "J.R.R. Tolkien" },
  { title: "The Return of the King", author: "J.R.R. Tolkien" },
];

// const books: Book[] = [];
---

<BaseLayout>
  <div class="content">
    <h2>Books</h2>
    {books.map((book) => <BookCard book={book} />)}
    {
      books.length < 1 && (
        <p>No books available at the moment. Please check back later.</p>
      )
    }
  </div>
</BaseLayout>
